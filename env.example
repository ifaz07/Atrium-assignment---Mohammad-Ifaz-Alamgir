# Atrium — environment configuration
#
# Copy this file to .env and fill in the values for your machine.
#   cp env.example .env
#
# Never commit .env. As you add features that need configuration, add the
# variables here too — a marker sets up your project from this file alone.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atrium
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/atrium_test

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Centre timezone. All opening hours, week boundaries and scheduled jobs are
# evaluated in this zone. Do not assume it equals the server's zone.
CENTRE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Session and authentication
# ---------------------------------------------------------------------------
SESSION_SECRET=atrium-local-demo-session-secret-2026

# Starter administrator account, created by the migration.
SEED_ADMIN_EMAIL=admin@atrium.local
SEED_ADMIN_PASSWORD=admin
SEED_PARTICIPANT_EMAIL=sofia.marino@atrium.local
SEED_PARTICIPANT_PASSWORD=participant-demo
SEED_COACH_EMAIL=oscar.lindqvist@atrium.local
SEED_COACH_PASSWORD=coach-demo

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Mailpit receives local SMTP on port 1025 and shows it at http://localhost:8025.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@atrium.local

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Both digests run at 00:00 in CENTRE_TIMEZONE, not in UTC and not in the
# server's local zone.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Assistant
# ---------------------------------------------------------------------------
# Any provider. Base URL and model name go here so they can be pointed
# elsewhere. Tests must not require a live model — provide a deterministic
# stub behind the same interface and select it here.
MODEL_PROVIDER=stub
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
